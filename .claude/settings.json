{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin master)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh api repos/hughrobertson19/portfolio/branches:*)",
      "Bash(gh api repos/hughrobertson19/portfolio/rulesets:*)",
      "Bash(gh api -X PUT repos/hughrobertson19/portfolio/branches:*)",
      "Bash(gh api -X DELETE repos/hughrobertson19/portfolio/branches:*)",
      "Bash(gh pr merge:*)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-risky.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
